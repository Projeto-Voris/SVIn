<launch>

    <!-- Arguments -->
    <arg name="config" default="$(find-pkg-share okvis_ros)/config/config_stereorig_v2.yaml"/>

    <set_parameter name="use_sim_time" value="true"/>

    <!-- To un-compress and sync the image topics -->
    <node name="stereo_sync" exec="stereo_sync" pkg="okvis_ros" output="screen">
        <param name="config_filename" value="$(var config)"/>
        <param name="left_img_topic" value="/slave1/image_raw"/>
        <param name="right_img_topic" value="/slave2/image_raw"/>
        <param name="compressed" value="true"/>
    </node>

    <!-- Run pose_graph node-->
    <node name="pose_graph_node" pkg="pose_graph" exec="pose_graph_node">
        <param name="config_file" type="str" value="$(var config)"/>
    </node>

    <node pkg="okvis_ros" exec="okvis_node" name="okvis_node" output="screen">
        <remap from="/cam0/image_raw" to="/Passive/left/image_raw"/>
        <remap from="/cam1/image_raw" to="/Passive/right/image_raw"/>
        <remap from="/imu0" to="/mavros/imu/data"/>
        <remap from="/sonar_data" to="/sonar_3d/pointcloud"/>
    </node>


    <node name="okvis_node" pkg="okvis_ros" exec="okvis_node">

        <param name="config_filename" value="$(var config)"/>
        <param name="mesh_file" value="firefly.dae"/>

        <remap from="/camera0" to="/Passive/left/image_raw"/>
        <remap from="/camera1" to="/Passive/right/image_raw"/>

        <remap from="/imu" to="/model/bluerov2/imu"/>

    </node>

    <node name="rviz" pkg="rviz2" exec="rviz2" args="-d $(find-pkg-share okvis_ros)/rviz_config/svin.rviz"/>

</launch>
